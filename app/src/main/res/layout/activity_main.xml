<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Warm Top HUD -->
    <LinearLayout
        android:id="@+id/headerMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- Row 1: Back, Mode/Level Pill, Vector Hearts, Coins, Sound -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnQuitGame"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_ivory_3d"
                android:clickable="true"
                android:focusable="true"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLevelMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_oat"
                android:gravity="center"
                android:paddingHorizontal="11dp"
                android:text="Lv.1 • Dễ"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Vector Hearts Container -->
            <LinearLayout
                android:id="@+id/llHearts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Blitz Label when Hearts are hidden -->
            <TextView
                android:id="@+id/tvBlitzBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="+1.5s / -3s"
                android:textColor="@color/accent_terracotta"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Coins Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_amber"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvGameCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="120"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnSoundToggle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_ivory_3d"
                android:clickable="true"
                android:focusable="true"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/ivSoundIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sound_on" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2: Score, Combo Pill & Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 đ"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llComboBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_amber"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:visibility="invisible">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_fire" />

                <TextView
                    android:id="@+id/tvComboText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="COMBO 2"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTimeDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="+1.5s"
                android:textColor="@color/emerald_correct"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTimerSec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15.0s"
                android:textColor="@color/brand_forest"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbTimer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="1000"
            android:progressDrawable="@drawable/bg_progress_timer" />
    </LinearLayout>

    <!-- Explorer's Sketchbook Shadow Stage -->
    <FrameLayout
        android:id="@+id/cardShadowStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_stage_frame"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Warm Sunlight Radial Halo -->
        <View
            android:layout_width="175dp"
            android:layout_height="175dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_stage_glow" />

        <!-- Silhouette / Revealed Animal -->
        <ImageView
            android:id="@+id/ivMainShadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="22dp"
            android:layout_marginVertical="10dp"
            android:scaleType="fitCenter" />

        <!-- Mystery Fog Occlusion Overlay -->
        <FrameLayout
            android:id="@+id/vFogMask"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="18dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_fog_mask"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="MÀN SƯƠNG CHE KHUẤT"
                android:textColor="#F6F1E7"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Active Modifier Pill -->
        <TextView
            android:id="@+id/tvModifierTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_pill_oat"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Xoay bóng"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Inline Reveal Feedback Pill -->
        <TextView
            android:id="@+id/tvFeedbackBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_pill_sage"
            android:elevation="4dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Chính xác!"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Prompt / Hint Strip -->
    <TextView
        android:id="@+id/tvHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/prompt_guess_shadow"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Answer Grid (2 columns x up to 3 rows) -->
    <GridLayout
        android:id="@+id/gridOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="5dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:rowCount="3">

        <FrameLayout
            android:id="@+id/cardOption0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/ivOption0"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:padding="9dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardOption1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/ivOption1"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:padding="9dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardOption2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/ivOption2"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:padding="9dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardOption3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/ivOption3"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:padding="9dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardOption4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/ivOption4"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:padding="9dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardOption5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/ivOption5"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:padding="9dp"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </GridLayout>

    <!-- Bottom Tactile Power-Up Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnPower5050"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ivory_3d"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="7dp"
            android:paddingBottom="9dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_cut_5050" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="50/50"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPower5050"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Miễn phí"
                android:textColor="@color/brand_forest"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPowerFreeze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ivory_3d"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="7dp"
            android:paddingBottom="9dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_hourglass_plus" />

                <TextView
                    android:id="@+id/tvPowerFreezeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="+6s Rõ Bóng"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPowerFreeze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Miễn phí"
                android:textColor="@color/accent_terracotta"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPowerHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ivory_3d"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="7dp"
            android:paddingBottom="9dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_lightbulb" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Gợi Ý"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPowerHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Miễn phí"
                android:textColor="@color/amber_lip"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
