<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardAchievementItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_card_tactile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="13dp"
    android:paddingTop="13dp"
    android:paddingBottom="15dp">

    <FrameLayout
        android:id="@+id/flAchIconWrap"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_pill_amber"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivAchIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_trophy" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kỷ Lục Gia Thảo Nguyên"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAchDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ghi từ 300 điểm trở lên trong một ván"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llAchStatus"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_sage"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="9dp">

        <ImageView
            android:id="@+id/ivAchStatusIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_check_circle" />

        <TextView
            android:id="@+id/tvAchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="ĐÃ ĐẠT"
            android:textColor="@color/brand_forest"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
