<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_tactile"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉnh Sửa Hồ Sơ"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditDisplayName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Tên hiển thị"
        app:boxBackgroundColor="@color/surface_input"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/brand_forest">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditDisplayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Chọn linh vật đại diện (8 loài):"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="4"
        android:rowCount="2">

        <FrameLayout
            android:id="@+id/editAvatar0"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/animal_cat" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/editAvatar1"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/animal_rabbit" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/editAvatar2"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/animal_owl" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/editAvatar3"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/animal_penguin" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/editAvatar4"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/animal_dolphin" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/editAvatar5"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/animal_frog" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/editAvatar6"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/con_cho_removebg_preview" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/editAvatar7"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card_tactile"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/con_soc_removebg_preview" />
        </FrameLayout>
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelProfile"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ivory_3d"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingBottom="3dp"
            android:text="Hủy"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveProfile"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_forest_3d"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="Lưu Thay Đổi"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
